# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Test-wallet private key (0x-prefixed). Used only for live deploy/simulate on Celo Sepolia.
# Use a throwaway testnet key — never a key that holds real funds.
PRIVATE_KEY=0xyour_test_private_key

# Celo Sepolia JSON-RPC. Default below; confirm the current endpoint on Chainlist (chainId 11142220)
# if it is stale.
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Stablecoin ERC-20 to split. Default is USDC on Celo Sepolia.
# USDC: 0x01C5C0122039549AD1493B8220cABEdD739BC44E   (6 decimals; Circle faucet, MiniPay-supported)
# USDm: 0xdE9e4C3ce781b4bA68120d6261cbad65ce0aB00b   (Mento Dollar — closest cUSD lineage)
STABLE_TOKEN_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E

# Optional — only for Celoscan verification (Blockscout/Sourcify need no key).
# Single unified Etherscan v2 key works across chains: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional overrides for the stablecoin simulation.
# SPLITTER_ADDRESS=          # reuse an already-deployed CusdPaySplitter
# RECIPIENTS=0xaddr1,0xaddr2 # payout addresses (else two random addresses are generated)
# DEPOSIT_AMOUNT=1.0         # human units of stablecoin to deposit
