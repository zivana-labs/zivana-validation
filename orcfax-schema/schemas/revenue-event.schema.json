{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zivana.io/schemas/revenue-event.schema.json",
  "title": "Zivana Revenue Event Fact Statement",
  "description": "JSON Schema validating the structural shape of the Schema.org Claim used as the off-chain audit document for a Zivana revenue-event fact statement.",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "identifier",
    "dateCreated",
    "temporalCoverage",
    "text",
    "about",
    "claimInterpreter"
  ],
  "additionalProperties": true,
  "properties": {
    "@context": { "const": "https://schema.org" },
    "@type": { "const": "Claim" },
    "identifier": { "type": "string", "minLength": 1 },
    "dateCreated": { "type": "string", "format": "date-time" },
    "temporalCoverage": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}/\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 time interval, e.g. 2026-05-01/2026-05-14"
    },
    "text": { "type": "string", "minLength": 1 },
    "about": {
      "type": "object",
      "required": ["@type", "observationAbout", "observationDate", "variableMeasured", "value"],
      "properties": {
        "@type": { "const": "Observation" },
        "observationAbout": {
          "type": "object",
          "required": ["@type", "identifier", "name"],
          "properties": {
            "@type": { "enum": ["Person", "Organization"] },
            "identifier": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "observationDate": { "type": "string", "format": "date" },
        "variableMeasured": { "type": "string", "minLength": 1 },
        "value": {
          "type": "object",
          "required": ["@type", "currency", "value"],
          "properties": {
            "@type": { "const": "MonetaryAmount" },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 currency code"
            },
            "value": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "claimInterpreter": {
      "type": "object",
      "required": ["@type", "identifier", "name"],
      "properties": {
        "@type": { "enum": ["Organization", "Person"] },
        "identifier": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
